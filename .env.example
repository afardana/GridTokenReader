# Copy to .env (git-ignored) and fill in. Read at build time by
# firmware/scripts/load_env.py. Leave a value empty to disable that feature.

# Wi-Fi (SSID / PASS are accepted as aliases)
WIFI_SSID=
WIFI_PASSWORD=

# Transport A: MQTT
MQTT_HOST=
MQTT_PORT=1883
MQTT_USER=
MQTT_PASSWORD=

# Transport B: HTTP(S) POST of each JPEG, e.g. a Node-RED "http in" node
INGEST_URL=https://nodered.example.com/gridtoken/ingest
# Optional: connect to this LAN IP but validate TLS against the URL's hostname
INGEST_CONNECT_IP=
# Node-RED httpNodeAuth credentials
INGEST_USER=
INGEST_PASSWORD=

# OTA: password for ArduinoOTA (pio run -e esp32cam-ota -t upload) and the
# web uploader at http://<device>/update (user "admin"). Empty = OTA disabled.
OTA_PASSWORD=
# Device address for OTA uploads (IP or gridtoken-xxxxxx.local)
OTA_HOST=

# Seconds between captures
CAPTURE_INTERVAL_S=300
