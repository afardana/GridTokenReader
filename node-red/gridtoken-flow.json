[
  {
    "id": "gt_tab",
    "type": "tab",
    "label": "GridTokenReader",
    "disabled": false,
    "info": "Ingests JPEG frames from GridTokenReader ESP32-CAM devices (HTTP POST and/or MQTT), stores them for dataset collection, and hands them to the recogniser (placeholder in Phase 0)."
  },
  {
    "id": "gt_comment",
    "type": "comment",
    "z": "gt_tab",
    "name": "Frames in via HTTP POST /gridtoken/ingest or MQTT gridtoken/+/image",
    "info": "Set env var GRIDTOKEN_DIR on this tab (default /tmp/gridtoken) to choose where frames are stored.",
    "x": 290,
    "y": 40,
    "wires": []
  },
  {
    "id": "gt_http_in",
    "type": "http in",
    "z": "gt_tab",
    "name": "POST /gridtoken/ingest",
    "url": "/gridtoken/ingest",
    "method": "post",
    "upload": false,
    "swaggerDoc": "",
    "x": 160,
    "y": 100,
    "wires": [["gt_norm_http"]]
  },
  {
    "id": "gt_norm_http",
    "type": "function",
    "z": "gt_tab",
    "name": "normalise (http)",
    "func": "if (!Buffer.isBuffer(msg.payload) || msg.payload.length < 100) {\n    msg.statusCode = 400;\n    return [null, msg];\n}\nmsg.device = String(msg.req.headers['x-device-id'] || 'unknown').replace(/[^a-z0-9-]/gi, '');\nmsg.firmware = msg.req.headers['x-firmware'] || null;\nmsg.image = msg.payload;\nmsg.ts = Date.now();\nmsg.statusCode = 204;\nreturn [msg, msg];",
    "outputs": 2,
    "timeout": 0,
    "noerr": 0,
    "initialize": "",
    "finalize": "",
    "libs": [],
    "x": 400,
    "y": 100,
    "wires": [["gt_frame"], ["gt_http_resp"]]
  },
  {
    "id": "gt_http_resp",
    "type": "http response",
    "z": "gt_tab",
    "name": "ack",
    "statusCode": "",
    "headers": {},
    "x": 590,
    "y": 140,
    "wires": []
  },
  {
    "id": "gt_mqtt_in",
    "type": "mqtt in",
    "z": "gt_tab",
    "name": "gridtoken/+/image",
    "topic": "gridtoken/+/image",
    "qos": "0",
    "datatype": "buffer",
    "broker": "gt_broker",
    "nl": false,
    "rap": true,
    "rh": 0,
    "inputs": 0,
    "x": 150,
    "y": 200,
    "wires": [["gt_norm_mqtt"]]
  },
  {
    "id": "gt_norm_mqtt",
    "type": "function",
    "z": "gt_tab",
    "name": "normalise (mqtt)",
    "func": "msg.device = msg.topic.split('/')[1];\nmsg.firmware = null;\nmsg.image = msg.payload;\nmsg.ts = Date.now();\nreturn msg;",
    "outputs": 1,
    "timeout": 0,
    "noerr": 0,
    "initialize": "",
    "finalize": "",
    "libs": [],
    "x": 400,
    "y": 200,
    "wires": [["gt_frame"]]
  },
  {
    "id": "gt_frame",
    "type": "junction",
    "z": "gt_tab",
    "x": 560,
    "y": 160,
    "wires": [["gt_store_path", "gt_recognise"]]
  },
  {
    "id": "gt_store_path",
    "type": "function",
    "z": "gt_tab",
    "name": "dataset path",
    "func": "const dir = env.get('GRIDTOKEN_DIR') || '/tmp/gridtoken';\nconst stamp = new Date(msg.ts).toISOString().replace(/[:.]/g, '-');\nmsg.filename = `${dir}/${msg.device}/${stamp}.jpg`;\nmsg.payload = msg.image;\nreturn msg;",
    "outputs": 1,
    "timeout": 0,
    "noerr": 0,
    "initialize": "",
    "finalize": "",
    "libs": [],
    "x": 710,
    "y": 120,
    "wires": [["gt_file_out"]]
  },
  {
    "id": "gt_file_out",
    "type": "file",
    "z": "gt_tab",
    "name": "save frame",
    "filename": "filename",
    "filenameType": "msg",
    "appendNewline": false,
    "createDir": true,
    "overwriteFile": "true",
    "encoding": "none",
    "x": 890,
    "y": 120,
    "wires": [[]]
  },
  {
    "id": "gt_recognise",
    "type": "function",
    "z": "gt_tab",
    "name": "recognise (Phase 2 TODO)",
    "func": "// Phase 2: crop the LCD ROI and run digit recognition here (or call a\n// recogniser service). Must output: { device, ts, kwh, confidence, raw }.\nmsg.payload = {\n    device: msg.device,\n    ts: msg.ts,\n    bytes: msg.image.length,\n    kwh: null,\n    confidence: 0,\n    status: 'recogniser-not-implemented'\n};\nreturn msg;",
    "outputs": 1,
    "timeout": 0,
    "noerr": 0,
    "initialize": "",
    "finalize": "",
    "libs": [],
    "x": 750,
    "y": 200,
    "wires": [["gt_debug_reading"]]
  },
  {
    "id": "gt_debug_reading",
    "type": "debug",
    "z": "gt_tab",
    "name": "reading",
    "active": true,
    "tosidebar": true,
    "console": false,
    "tostatus": true,
    "complete": "payload",
    "targetType": "msg",
    "statusVal": "payload.status",
    "statusType": "msg",
    "x": 960,
    "y": 200,
    "wires": []
  },
  {
    "id": "gt_mqtt_status",
    "type": "mqtt in",
    "z": "gt_tab",
    "name": "gridtoken/+/status",
    "topic": "gridtoken/+/status",
    "qos": "0",
    "datatype": "json",
    "broker": "gt_broker",
    "nl": false,
    "rap": true,
    "rh": 0,
    "inputs": 0,
    "x": 150,
    "y": 280,
    "wires": [["gt_debug_status"]]
  },
  {
    "id": "gt_debug_status",
    "type": "debug",
    "z": "gt_tab",
    "name": "device status",
    "active": true,
    "tosidebar": true,
    "console": false,
    "tostatus": false,
    "complete": "payload",
    "targetType": "msg",
    "x": 390,
    "y": 280,
    "wires": []
  },
  {
    "id": "gt_inject_capture",
    "type": "inject",
    "z": "gt_tab",
    "name": "capture now (edit device id)",
    "props": [{ "p": "payload" }, { "p": "topic", "vt": "str" }],
    "repeat": "",
    "crontab": "",
    "once": false,
    "onceDelay": 0.1,
    "topic": "gridtoken/gridtoken-XXXXXX/cmd/capture",
    "payload": "1",
    "payloadType": "str",
    "x": 190,
    "y": 340,
    "wires": [["gt_mqtt_out"]]
  },
  {
    "id": "gt_mqtt_out",
    "type": "mqtt out",
    "z": "gt_tab",
    "name": "",
    "topic": "",
    "qos": "0",
    "retain": "false",
    "broker": "gt_broker",
    "x": 430,
    "y": 340,
    "wires": []
  },
  {
    "id": "gt_broker",
    "type": "mqtt-broker",
    "name": "local broker",
    "broker": "127.0.0.1",
    "port": "1883",
    "clientid": "",
    "autoConnect": true,
    "usetls": false,
    "protocolVersion": "4",
    "keepalive": "60",
    "cleansession": true
  }
]
